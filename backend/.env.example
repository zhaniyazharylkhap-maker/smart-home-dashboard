# If Postgres runs via docker compose (default host port 5433), use port 5433 here.
DATABASE_URL=postgresql://smarthome:smarthome@localhost:5433/smarthome
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=smarthome_backend
MQTT_PASSWORD=change-me-strong-password
MQTT_TELEMETRY_TOPIC=smarthome/telemetry
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Must be a real 32+ char secret; the literal "__REPLACE_ME__" is rejected at boot.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=__REPLACE_ME__
